{
  "name": "dictionary-game-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"pnpm --filter @dict-game/server dev\" \"pnpm --filter @dict-game/client dev\"",
    "build": "pnpm --filter @dict-game/shared build && pnpm --filter @dict-game/server build && pnpm --filter @dict-game/client build",
    "start": "pnpm --filter @dict-game/server start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
